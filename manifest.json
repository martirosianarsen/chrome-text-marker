{
  "manifest_version": 3,
  "name": "Text Marker \u2013 Powerful Webpage Text Highlighter",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Highlight passages in your favorite colors. Find, revisit and export your saved highlights. Private, local, and free.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Text Marker",
    "default_icon": {
      "16": "icons/text_marker_16.png",
      "32": "icons/text_marker_32.png",
      "48": "icons/text_marker_48.png",
      "128": "icons/text_marker_128.png"
    }
  },
  "icons": {
    "16": "icons/text_marker_16.png",
    "32": "icons/text_marker_32.png",
    "48": "icons/text_marker_48.png",
    "128": "icons/text_marker_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
